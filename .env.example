# Copy to .env for docker compose on this machine. The Lambda deployment reads
# .env.production instead (see .env.production.example).

# Comma-separated; each at least 16 characters. Generate one with:
#   openssl rand -hex 32
API_KEYS=

# Host port; the API is published on 127.0.0.1 only.
# RENDER_PORT=3000

# Everything below is optional; blank or absent means the application's own
# default, shown here. See "Configuration" in README.md.
# MAX_CONCURRENCY=2
# MAX_QUEUE=20
# JOB_TIMEOUT_MS=60000
# NAVIGATION_TIMEOUT_MS=30000
# MAX_IMAGE_HEIGHT=32768
# MAX_CAPTURE_HEIGHT=100000
# BROWSER_RECYCLE_AFTER=200
# IDLE_SHUTDOWN_MS=60000
# CHROMIUM_SANDBOX=false
# ALLOW_PRIVATE_NETWORKS=false
# LOG_LEVEL=info
