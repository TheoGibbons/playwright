# Standalone defaults for a local run. API_KEYS is deliberately blank so no
# working key is ever committed; scripts/up-local.sh generates one into .env the
# first time it runs.

# Comma-separated; each at least 16 characters. Generate one with:
#   openssl rand -hex 32
API_KEYS=

# Where the API is published on the host.
#   local : 127.0.0.1:3088 — reachable from this machine and nothing else
#   LIVE  : APP_BIND=0.0.0.0 and APP_PORT=80 for a public standalone deployment,
#           with your own TLS terminator in front
APP_BIND=127.0.0.1
APP_PORT=3088

# Everything below is optional; blank or absent means the application's own
# default, shown here. See "Configuration" in README.md.
# MAX_CONCURRENCY=2
# MAX_QUEUE=20
# JOB_TIMEOUT_MS=60000
# NAVIGATION_TIMEOUT_MS=30000
# MAX_IMAGE_HEIGHT=32768
# MAX_CAPTURE_HEIGHT=100000
# BROWSER_RECYCLE_AFTER=200
# IDLE_SHUTDOWN_MS=60000
# CHROMIUM_SANDBOX=false
# ALLOW_PRIVATE_NETWORKS=false
# LOG_LEVEL=info
