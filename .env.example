# Comma-separated; each at least 16 characters. Generate one with:
#   openssl rand -hex 32
API_KEYS=

# Host port for the API (docker compose).
# RENDER_PORT=3000

# Only needed for the optional Caddy (HTTPS) service: the domain pointing at this server.
DOMAIN=render.example.com

# Everything below is optional; these are the defaults.
# MAX_CONCURRENCY=2
# MAX_QUEUE=20
# JOB_TIMEOUT_MS=60000
# NAVIGATION_TIMEOUT_MS=30000
# MAX_IMAGE_HEIGHT=32768
# MAX_CAPTURE_HEIGHT=100000
# BROWSER_RECYCLE_AFTER=200
# CHROMIUM_SANDBOX=false
# ALLOW_PRIVATE_NETWORKS=false
# LOG_LEVEL=info
