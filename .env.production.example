# Copy to .env on the server. Both LIVE paths read this file; which lines matter
# depends on which one you follow.

# --- Required, either path ---------------------------------------------------
# Comma-separated; each at least 16 characters. Blank on purpose: Compose
# refuses to start until it is set. Generate one with:
#   openssl rand -hex 32
API_KEYS=

# --- Deploying to LIVE (standalone, no Traefik) ------------------------------
# Publishes the API publicly on port 80. Put your own TLS terminator in front —
# Cloudflare, nginx or Caddy — because the API key travels in a request header.
# Ignored by the Traefik path below, which does not load
# docker-compose.override.yml at all.
APP_BIND=0.0.0.0
APP_PORT=80

# --- Deploying to LIVE with hobby-traefik ------------------------------------
# Public DNS name, pointed at this instance before deploying so Let's Encrypt
# can validate it.
APP_HOST=

# --- Optional, either path ---------------------------------------------------
# Every variable in the Configuration table in README.md can be set here; blank
# or absent means the application's own default.
