# Copy to .env.production. `bash scripts/deploy.sh` reads it and deploys it to
# the CloudFormation stack; push-to-deploy never sees it and keeps whatever was
# deployed last. Blank or absent means the default shown.

# --- Required ----------------------------------------------------------------
# Comma-separated; each at least 16 characters. Generate one with:
#   openssl rand -hex 32
# Needed on the first deploy and to change the keys; left blank, a deploy keeps
# the keys that are already deployed.
API_KEYS=

# Public hostname, served by CloudFront.
DOMAIN_NAME=playwright.sinkmailer.com

# Route 53 hosted zone that holds DOMAIN_NAME; the TLS certificate is validated
# through it. Find it with:
#   aws route53 list-hosted-zones-by-name --dns-name sinkmailer.com \
#     --query "HostedZones[?Name=='sinkmailer.com.'].Id" --output text
HOSTED_ZONE_ID=

# --- Spend limit (see "Spend limit" in README.md) ----------------------------
# Once this month's cost of everything tagged project=playwright passes this
# many US dollars, the API is switched off until the 1st of the next month.
# MONTHLY_BUDGET_USD=5

# Emailed at 80% and 100% of the budget. Optional.
ALERT_EMAIL=

# --- Lambda ------------------------------------------------------------------
# Instances that may run at once, each rendering one page; more simultaneous
# requests get 429. Also caps how fast money can be spent.
# LAMBDA_MAX_INSTANCES=2
# LAMBDA_MEMORY_MB=2048

# Only when the distribution is on a CloudFront flat-rate plan: the ARN of the
# AWS WAF web ACL the plan attached, so deploys keep it attached.
# CLOUDFRONT_WEB_ACL_ARN=

# --- Service -----------------------------------------------------------------
# See "Configuration" in README.md.
# JOB_TIMEOUT_MS=50000
# NAVIGATION_TIMEOUT_MS=30000
# MAX_IMAGE_HEIGHT=32768
# MAX_CAPTURE_HEIGHT=100000
# BROWSER_RECYCLE_AFTER=200
# LOG_LEVEL=info
